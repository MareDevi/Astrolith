---
interface Props {
  title: string;
  type?: "info" | "warning" | "note";
  collapsible?: boolean;
}

const { title, type = "info", collapsible = false } = Astro.props;
---

<aside class:list={["callout", `callout-${type}`]} data-collapsible={collapsible}>
  <strong class="callout-title">{title}</strong>
  <div class="callout-body"><slot /></div>
</aside>

<style>
  .callout {
    border-inline-start: 4px solid currentColor;
    padding: 0.75rem 1rem;
  }

  .callout-warning {
    color: firebrick;
  }

  .callout-note {
    color: darkslateblue;
  }
</style>
