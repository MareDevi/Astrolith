---
interface Props {
  title: string;
  href?: string;
  count?: number;
  tags?: string[];
}

const { title, href, count = 0, tags = [] } = Astro.props;
---

<article class="card" data-count={count}>
  <h3>
    {href ? <a href={href}>{title}</a> : title}
  </h3>
  {tags.length > 0 && <p class="card-tags">{tags.join(" · ")}</p>}
  <slot />
</article>

<style>
  .card {
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    padding: 1rem;
  }

  .card-tags {
    opacity: 0.7;
  }
</style>
